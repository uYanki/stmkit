  115 00000042         
  116 00000042         ;*******************************************************
                       *************************************************
  117 00000042         ;                                         HANDLE PendSV 
                       EXCEPTION
  118 00000042         ;                                     void OS_CPU_PendSV
                       Handler(void)
  119 00000042         ;
  120 00000042         ; Note(s) : 1) PendSV is used to cause a context switch.
                         This is a recommended method for performing
  121 00000042         ;              context switches with Cortex-M3.  This is
                        because the Cortex-M3 auto-saves half of the
  122 00000042         ;              processor context on any exception, and r
                       estores same on return from exception.  So only
  123 00000042         ;              saving of R4-R11 is required and fixing u
                       p the stack pointers.  Using the PendSV exception
  124 00000042         ;              this way means that context saving and re
                       storing is identical whether it is initiated from
  125 00000042         ;              a thread or occurs due to an interrupt or
                        exception.
  126 00000042         ;
  127 00000042         ;           2) Pseudo-code is:
  128 00000042         ;              a) Get the process SP, if 0 then skip (go
                       to d) the saving part (first context switch);
  129 00000042         ;              b) Save remaining regs r4-r11 on process 
                       stack;
  130 00000042         ;              c) Save the process SP in its TCB, OSTCBC
                       ur->OSTCBStkPtr = SP;
  131 00000042         ;              d) Call OSTaskSwHook();
  132 00000042         ;              e) Get current high priority, OSPrioCur =
                        OSPrioHighRdy;
  133 00000042         ;              f) Get current ready thread TCB, OSTCBCur
                        = OSTCBHighRdy;
  134 00000042         ;              g) Get new process SP from TCB, SP = OSTC
                       BHighRdy->OSTCBStkPtr;
  135 00000042         ;              h) Restore R4-R11 from new process stack;
                       
  136 00000042         ;              i) Perform exception return which will re
                       store remaining context.
  137 00000042         ;
  138 00000042         ;           3) On entry into PendSV handler:
  139 00000042         ;              a) The following have been saved on the p
                       rocess stack (by processor):
  140 00000042         ;                 xPSR, PC, LR, R12, R0-R3
  141 00000042         ;              b) Processor mode is switched to Handler 
                       mode (from Thread mode)
  142 00000042         ;              c) Stack is Main stack (switched from Pro
                       cess stack)
  143 00000042         ;              d) OSTCBCur      points to the OS_TCB of 
                       the task to suspend
  144 00000042         ;                 OSTCBHighRdy  points to the OS_TCB of 
                       the task to resume
  145 00000042         ;
  146 00000042         ;           4) Since PendSV is set to lowest priority in
                        the system (by OSStartHighRdy() above), we
  147 00000042         ;              know that it will only be run when no oth
                       er exception or interrupt is active, and
  148 00000042         ;              therefore safe to assume that context bei
                       ng switched out was using the process stack (PSP).



