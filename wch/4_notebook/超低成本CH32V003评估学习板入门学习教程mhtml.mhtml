ljs-number">0x00</span>;

    <span class=3D"hljs-keyword">if</span>((GPIOx-&gt;INDR &amp; GPIO_Pin) =
!=3D (<span class=3D"hljs-type">uint32_t</span>)Bit_RESET)
    {
