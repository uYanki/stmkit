 * @fn      TIM_TimeBaseInit
 *
 * @brief   Initializes the TIMx Time Base Unit peripheral according to
 *        the specified parameters in the TIM_TimeBaseInitStruct.
 *
 * @param   TIMx - where x can be 1 to 2 to select the TIM peripheral.
 *          TIM_TimeBaseInitStruct - pointer to a TIM_TimeBaseInitTypeDef
 *        structure.
 *
 * @return  none
 */</span>
<span class=3D"hljs-type">void</span> <span class=3D"hljs-title function_">=
TIM_TimeBaseInit</span><span class=3D"hljs-params">(TIM_TypeDef *TIMx, TIM_=
TimeBaseInitTypeDef *TIM_TimeBaseInitStruct)</span>
{
    <span class=3D"hljs-type">uint16_t</span> tmpcr1 =3D <span class=3D"hlj=
s-number">0</span>;

    tmpcr1 =3D TIMx-&gt;CTLR1;

    <span class=3D"hljs-keyword">if</span>((TIMx =3D=3D TIM1) || (TIMx =3D=
=3D TIM2))
    {
        tmpcr1 &amp;=3D (<span class=3D"hljs-type">uint16_t</span>)(~((<spa=
n class=3D"hljs-type">uint16_t</span>)(TIM_DIR | TIM_CMS)));
        tmpcr1 |=3D (<span class=3D"hljs-type">uint32_t</span>)TIM_TimeBase=
InitStruct-&gt;TIM_CounterMode;
    }

    tmpcr1 &amp;=3D (<span class=3D"hljs-type">uint16_t</span>)(~((<span cl=
ass=3D"hljs-type">uint16_t</span>)TIM_CTLR1_CKD));
    tmpcr1 |=3D (<span class=3D"hljs-type">uint32_t</span>)TIM_TimeBaseInit=
Struct-&gt;TIM_ClockDivision;

    TIMx-&gt;CTLR1 =3D tmpcr1;
    TIMx-&gt;ATRLR =3D TIM_TimeBaseInitStruct-&gt;TIM_Period;
    TIMx-&gt;PSC =3D TIM_TimeBaseInitStruct-&gt;TIM_Prescaler;

    <span class=3D"hljs-keyword">if</span>(TIMx =3D=3D TIM1)
    {
        TIMx-&gt;RPTCR =3D TIM_TimeBaseInitStruct-&gt;TIM_RepetitionCounter=
;
    }

    TIMx-&gt;SWEVGR =3D TIM_PSCReloadMode_Immediate;
}
